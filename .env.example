# MediaNexus environment (copy to .env for docker compose, or export for local run)
# Never expose this app to the public internet — it has no login/auth beyond a
# single system API key. LAN/private-network use only.
# --- secrets (REQUIRED) ---
# generate with: openssl rand -hex 32
MEDIA_NEXUS_SECRET=change-me-to-a-secret
MEDIA_NEXUS_SECRET_FILE=

# --- bootstrap (first run) ---
# leave unset to generate; set to make first-run deterministic
# MEDIA_NEXUS_BOOTSTRAP_KEY=

# --- runtime ---
NODE_ENV=production
PORT=7373
TZ=UTC
LOG_LEVEL=info
JOB_CONCURRENCY=2
AUTO_MIGRATE=true

# --- compose: host port for the web UI ---
WEB_PORT=8080

# --- TMDb metadata (powers Discover + per-title metadata refresh) ---
# Not an env var — set it in-app: System → Metadata (TMDB) after first boot.

# MediaNexus environment (copy to .env or export at run time)
NODE_ENV=development
PORT=7373

# SQLite:   file:./data/media-nexus.db
# Postgres: postgres://user:pass@localhost:5432/medianexus
DATABASE_URL=file:./data/media-nexus.db

# REQUIRED in production - generate with: openssl rand -hex 32
MEDIA_NEXUS_SECRET=dev-secret-change-me
MEDIA_NEXUS_SECRET_FILE=

# Comma-separated allowed CORS origins (empty = same-origin)
CORS_ORIGINS=
TRUST_PROXY=
LOG_LEVEL=info
JOB_CONCURRENCY=2
TZ=UTC

# Web (dev)
VITE_MEDIA_NEXUS_API_URL=/api
VITE_MEDIA_NEXUS_API_KEY=

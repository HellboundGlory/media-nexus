# MediaNexus environment (copy to .env for docker compose, or export for local run)
# --- secrets (REQUIRED) ---
# generate with: openssl rand -hex 32
MEDIA_NEXUS_SECRET=change-me-to-a-secret
MEDIA_NEXUS_SECRET_FILE=

# --- bootstrap (first run) ---
# leave unset to generate; set to make first-run deterministic
# MEDIA_NEXUS_BOOTSTRAP_KEY=
# MEDIA_NEXUS_BOOTSTRAP_ADMIN_PASSWORD=

# --- runtime ---
NODE_ENV=production
PORT=7373
TZ=UTC
# Comma-separated allowed CORS origins (empty = same-origin)
CORS_ORIGINS=
TRUST_PROXY=0
LOG_LEVEL=info
JOB_CONCURRENCY=2
AUTO_MIGRATE=true

# --- compose: host port for the web UI ---
WEB_PORT=8080

# --- (TMDb metadata import; set in-app or here) ---
# METADATA_TMDB_API_KEY=

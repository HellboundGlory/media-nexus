# MediaNexus — env for docker/docker-compose.example.yml (Postgres + Gluetun VPN).
# Copy this file to docker/.env — NOT the repo root — before running:
#   docker compose -f docker/docker-compose.example.yml up -d
# (the compose file's env_file defaults to ".env" resolved relative to its own directory,
# i.e. docker/.env, same as how volumes/`env_file:` normally resolve in Compose.)
#
# Never expose this app to the public internet — it has no login/auth beyond a
# single system API key. LAN/private-network use only.

# --- secrets (REQUIRED) ---
# generate with: openssl rand -hex 32
MEDIA_NEXUS_SECRET=change-me-to-a-secret
MEDIA_NEXUS_SECRET_FILE=

# --- bootstrap (first run) ---
# leave unset to generate; set to make first-run deterministic
# MEDIA_NEXUS_BOOTSTRAP_KEY=

# --- runtime ---
TZ=UTC
LOG_LEVEL=info
JOB_CONCURRENCY=2
AUTO_MIGRATE=true

# --- host port for the web UI (published on the gluetun service, not app) ---
WEB_PORT=7373

# --- NZBGet (usenet download client, routed through the VPN via gluetun) ---
NZBGET_PORT=6789
NZBGET_USER=nzbget
NZBGET_PASS=change-me-to-a-secret
# ownership for nzbget's /config and /downloads volumes; match your host user (`id -u`/`id -g`)
PUID=1000
PGID=1000

# --- Postgres (REQUIRED) ---
# DATABASE_URL itself is assembled from these three inside the compose file — you don't set
# DATABASE_URL directly here.
POSTGRES_USER=medianexus
POSTGRES_PASSWORD=change-me-to-a-secret
POSTGRES_DB=medianexus

# --- Gluetun VPN (REQUIRED) ---
# WireGuard shown; see https://github.com/qdm12/gluetun/wiki for OpenVPN or a different
# provider's exact variable names — swap VPN_TYPE and the vars below to match.
VPN_SERVICE_PROVIDER=change-me
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=change-me
WIREGUARD_ADDRESSES=change-me
# Optional: narrow gluetun to specific server locations, e.g. "Netherlands,Germany"
VPN_SERVER_COUNTRIES=
# Your LAN subnet, so Docker-internal traffic (app -> postgres) and the published web UI
# stay reachable without being forced through the VPN tunnel.
LAN_SUBNET=192.168.1.0/24

# --- TMDb metadata (powers Discover + per-title metadata refresh) ---
# Not an env var — set it in-app: System → Metadata (TMDB) after first boot.
